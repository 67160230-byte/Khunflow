# KhumFlow — Environment Variables Example
# Copy this to .env and fill in the values
# NEVER commit .env to version control

# ── Database ─────────────────────────────────────────────────
DB_PASSWORD=change_me_in_production

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production_use_openssl_rand

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# Platform operators (exact login emails, comma-separated). Keep empty by default.
PLATFORM_ADMIN_EMAILS=

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=

# ── Password reset email ──────────────────────────────────────
# Render blocks outbound SMTP on Free services. Resend sends over HTTPS.
# Verify your sender domain in Resend, then set these on the API service.
RESEND_API_KEY=
RESEND_FROM_EMAIL=security@your-verified-domain.com
EMAILS_FROM_NAME=KhumFlow Security
